# Soroban test snapshots, regenerated by `cargo test` and gitignored.
contracts/**/test_snapshots/

# Generated from public/openapi.json by `npm run emit-api-reference` (#1078).
# tests/api-reference.spec.ts asserts the committed file is byte-identical to
# the generator's output, so Prettier must not reformat it — the two would
# disagree forever (Prettier pads table columns, the generator does not).
docs/API_REFERENCE.md

# Cargo build artifacts. Git already ignores these via nested .gitignore
# files, but Prettier walks the filesystem, not the index — after any local
# `cargo build`, format:check would otherwise scan target/ JSON fingerprints
# and fail the release gate before it checked anything real.
contracts/**/target/
crates/**/target/
examples/**/target/
