{
  "openapi": "3.1.0",
  "info": {
    "title": "Stellar Intel API",
    "version": "1.2.0",
    "description": "Intent router and anchor rate aggregation API for the Stellar Intel platform."
  },
  "servers": [
    {
      "url": "https://stellar-intel.vercel.app",
      "description": "Production"
    }
  ],
  "components": {
    "schemas": {
      "OfframpIntent": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "minLength": 1
          },
          "corridorId": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,7})?$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          }
        },
        "required": [
          "anchorId",
          "corridorId",
          "amount",
          "publicKey"
        ]
      },
      "SignedIntentEnvelope": {
        "type": "object",
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/OfframpIntent"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "publicKey": {
            "type": "string",
            "pattern": "^G[A-Z2-7]{55}$"
          }
        },
        "required": [
          "intent",
          "hash",
          "signature",
          "publicKey"
        ]
      },
      "IntentV1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Source asset identifier (e.g. \"stellar:USDC:GA5...\")"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Destination fiat identifier (e.g. \"iso4217:NGN\")"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "floor": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "deadline": {
            "type": "string",
            "description": "RFC 3339 datetime after which the intent must not execute"
          },
          "recipient": {
            "type": "string",
            "minLength": 1
          },
          "nonce": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$/i",
            "description": "128-bit random hex for replay protection"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "amount",
          "floor",
          "deadline",
          "recipient",
          "nonce"
        ]
      },
      "OfframpRoute": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string"
          },
          "anchorDomain": {
            "type": "string"
          },
          "corridorId": {
            "type": "string"
          },
          "estimatedFee": {
            "type": "string"
          },
          "estimatedReceived": {
            "type": "string"
          }
        },
        "required": [
          "anchorId",
          "anchorDomain",
          "corridorId",
          "estimatedFee",
          "estimatedReceived"
        ]
      },
      "OfframpIntentResponse": {
        "type": "object",
        "properties": {
          "route": {
            "$ref": "#/components/schemas/OfframpRoute"
          },
          "unsignedTx": {
            "type": "string",
            "description": "XDR-encoded unsigned Stellar transaction"
          },
          "quoteId": {
            "type": "string",
            "description": "Hex-encoded SHA-256 quote identifier"
          }
        },
        "required": [
          "route",
          "unsignedTx",
          "quoteId"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "IntentRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "offramp"
            ]
          },
          "sourceAsset": {
            "type": "string",
            "minLength": 1
          },
          "destinationAsset": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "sender": {
            "type": "string",
            "minLength": 1,
            "description": "Stellar public key of the sender"
          },
          "recipient": {
            "type": "string",
            "minLength": 1,
            "description": "Destination address for the payout"
          }
        },
        "required": [
          "type",
          "sourceAsset",
          "destinationAsset",
          "amount",
          "sender",
          "recipient"
        ]
      },
      "AnchorHealthResponse": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "description": "Unique anchor identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail",
              "unknown",
              "stale"
            ],
            "description": "Current health status: ok, fail, unknown (never checked), or stale (last check >24h ago)"
          },
          "consecutiveFailures": {
            "type": "number",
            "description": "Consecutive nightly validation failures"
          },
          "degraded": {
            "type": "boolean",
            "description": "True when anchor is auto-flagged degraded after repeated failures"
          },
          "lastCheckedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO timestamp of the last nightly check, or null if never checked"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure reason from the last check, or null on success"
          },
          "stale": {
            "type": "boolean",
            "description": "True when the last probe is older than 24 hours"
          }
        },
        "required": [
          "anchorId",
          "status",
          "consecutiveFailures",
          "degraded",
          "lastCheckedAt",
          "lastError",
          "stale"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/intent/offramp": {
      "post": {
        "summary": "Submit an off-ramp intent",
        "description": "Resolves an anchor route for the given asset corridor, builds an unsigned Stellar payment transaction, and returns a quote ID.",
        "tags": [
          "Intent"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Route resolved and unsigned transaction built",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfframpIntentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or no route found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Transaction build failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/anchors/{id}/health": {
      "get": {
        "summary": "Get anchor health status",
        "description": "Returns the anchor's current health status, last-probe timestamp, and score breakdown. Returns 'unknown' or 'stale' when probes haven't run recently — honest degradation rather than fabricated data.",
        "tags": [
          "Anchors"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Anchor identifier (e.g. moneygram, cowrie, anclap)"
            },
            "required": true,
            "description": "Anchor identifier (e.g. moneygram, cowrie, anclap)",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Anchor health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnchorHealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid anchor ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Anchor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "retryAfter": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error",
                    "retryAfter"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
